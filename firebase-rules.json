{
  "rules": {
    "submissions": {
      ".read": true,
      ".write": true,
      "$submissionId": {
        ".validate": "newData.hasChildren(['leader_id', 'score', 'createdAt', 'track'])",
        "leader_id": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "track": {
          ".validate": "newData.isString() && (newData.val() == 'verified' || newData.val() == 'unverified')"
        }
      }
    },
    "fraud_detection": {
      ".read": true,
      ".write": true,
      ".indexOn": ["ip_address"],
      "$fraudId": {
        ".validate": "newData.hasChildren(['fingerprint_hash', 'ip_address', 'visitor_id', 'submissionTimestamp'])"
      }
    },
    "flagged_submissions": {
      ".read": true,
      ".write": true,
      "$flagId": {
        ".validate": "newData.hasChildren(['ip_address', 'count_from_ip', 'fingerprints', 'status', 'admin_note', 'createdAt'])"
      }
    },
    "voted_emails": {
      ".read": true,
      ".write": true,
      ".indexOn": ["emailHash"],
      "$emailHash": {
        ".validate": "newData.hasChildren(['submittedAt'])"
      }
    },
    "config": {
      ".read": true,
      ".write": true,
      "voting_window": {
        ".validate": "newData.hasChildren(['isOpen'])"
      },
      "tracks": {
        ".validate": "newData.hasChildren(['unverifiedEnabled'])",
        "unverifiedEnabled": {
          ".validate": "newData.isBoolean()"
        }
      }
    }
  }
}
